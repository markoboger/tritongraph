{
  "name": "triton-conformance",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "triton-conformance": "./dist/cli.js"
  },
  "exports": {
    ".": "./src/index.ts",
    "./types": "./src/types.ts",
    "./matchKey": "./src/matchKey.ts",
    "./validate": "./src/validate.ts",
    "./astExtractor": "./src/astExtractor.ts",
    "./gitDiff": "./src/gitDiff.ts",
    "./check": "./src/check.ts",
    "./reporter": "./src/reporter.ts"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/cli.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0"
  }
}
