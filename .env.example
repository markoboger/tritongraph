# Copy to `.env` in this directory. Docker Compose loads `.env` automatically for ${VAR} substitution.
#
# When using ngrok (`ngrok http 4317`), paste the HTTPS forwarding URL here (no trailing slash).
# Free ngrok URLs change each time you restart ngrok unless you use a reserved domain.
#
TRITON_PUBLIC_RUNTIME_URL=https://YOUR-SUBDOMAIN.ngrok-free.dev

# Conformance checker LLM (optional). The runtime server's /api/conformance/llm proxy and the
# conformance CLI read these. The key stays server-side; never commit a real .env (it is gitignored).
#
# Default: local Ollama (free). For a hosted provider use e.g.
#   CONFORMANCE_BASE_URL=https://openrouter.ai/api/v1 and a real CONFORMANCE_API_KEY.
CONFORMANCE_API_KEY=ollama
CONFORMANCE_BASE_URL=http://localhost:11434/v1
CONFORMANCE_MODEL=qwen2.5-coder:7b
